# Runner image for the optional Airflow DAG. Data stay on the host (bind mount).
#   docker build -f orchestration/airflow/Dockerfile.pipeline -t batting-order-pipeline:latest .
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/batting-order
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[ingest]"
WORKDIR /app
CMD ["batting-order", "--help"]
