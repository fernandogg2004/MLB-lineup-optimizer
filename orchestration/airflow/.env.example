# Copy to orchestration/airflow/.env and edit. Never commit the real .env.
# Absolute path of the repository on the host (bind-mounted into the runner).
HOST_PROJECT_DIR=/absolute/path/to/mlb-lineup-optimizer
PIPELINE_IMAGE=batting-order-pipeline:latest
# Leave empty for manual runs only. Example daily schedule: 0 11 * * *
BATTING_ORDER_SCHEDULE=
# Extra flags for `batting-order update`, e.g. --last 30
BATTING_ORDER_UPDATE_ARGS=
AIRFLOW_UID=50000
# Change these before starting the stack.
_AIRFLOW_WWW_USER_USERNAME=change-me
_AIRFLOW_WWW_USER_PASSWORD=change-me
